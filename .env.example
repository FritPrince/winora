# URL publique du site — utilisée pour les redirections d'auth
# (lien magique, OAuth, confirmation d'email). En local : localhost.
# En prod : l'URL Vercel, et l'ajouter aussi dans Supabase Auth >
# URL Configuration > Redirect URLs, sinon les redirections échouent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Moneroo (Dashboard > API keys) — jamais exposé côté client
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=
